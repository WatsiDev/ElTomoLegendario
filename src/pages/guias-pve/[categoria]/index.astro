---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const pveImagesGlob = import.meta.glob<{ default: ImageMetadata }>("/src/assets/game-modes/**/*.{png,jpg,jpeg,webp,svg}", { eager: true });

export async function getStaticPaths() {
  const bossFiles = import.meta.glob('/src/data/game-modes/pve/*/*.json', { eager: true });
  const allBosses = Object.values(bossFiles).map((file: any) => file.default || file);
  
  const categoryFiles = import.meta.glob('/src/data/game-modes/pve-categories/*.json', { eager: true });
  const allCategories = Object.values(categoryFiles).map((file: any) => file.default || file);

  // Extraer categorías únicas de bosses válidos
  const validBosses = allBosses.filter((boss: any) => boss.category);
  const bossCategories = [...new Set(validBosses.map((boss: any) => boss.category))];

  return bossCategories.map((categorySlug) => {
    const categoryData = allCategories.find((cat: any) => cat.slug === categorySlug);
    return {
      params: { categoria: categorySlug as string },
      props: { 
        bosses: validBosses.filter((boss: any) => boss.category === categorySlug),
        categoryData: categoryData || { title: categorySlug }
      }
    };
  });
}

const { categoria } = Astro.params;
const { bosses, categoryData } = Astro.props;

const pageTitle = categoryData.title;
---

<Layout title={`${pageTitle} - Guías PvE - El Tomo Legendario`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 animate-fade-in">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex text-sm text-gray-400">
      <a href="/guias-pve" class="hover:text-raid-gold transition-colors">Guías PvE</a>
      <span class="mx-2">/</span>
      <span class="text-gray-200">{pageTitle}</span>
    </nav>

    <!-- Header -->
    <div class="mb-12 border-b border-gray-700/50 pb-6">
      <h1 class="text-4xl font-black uppercase tracking-wider text-white flex items-center gap-4">
        <span class="bg-raid-gold w-2 h-10 rounded-full inline-block"></span>
        {pageTitle}
      </h1>
      <p class="text-gray-400 mt-4 max-w-3xl">
        Selecciona un jefe para ver sus mecánicas, estrategias y los mejores equipos para derrotarlo.
      </p>
    </div>

    <!-- Grid de Jefes -->
    {bosses.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {bosses.map((boss: any) => (
          <a 
            href={`/guias-pve/${categoria}/${boss.slug}`}
            class="bg-raid-card border border-gray-700 rounded-xl overflow-hidden shadow-lg hover:border-raid-gold hover:shadow-raid-gold/20 transition-all duration-300 group flex flex-col"
          >
            <!-- Imagen del Jefe -->
            <div class="aspect-square w-full relative overflow-hidden bg-gray-900">
              {boss.image ? (
                <Image 
                  src={(boss.image && pveImagesGlob[boss.image] ? pveImagesGlob[boss.image].default : boss.image) as any} 
                  alt={boss.name}
                  width={600}
                  height={600}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-600">
                  <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
              
              <!-- Overlay Gradient -->
              <div class="absolute inset-0 bg-linear-to-t from-raid-card via-transparent to-transparent"></div>
            </div>

            <!-- Info del Jefe -->
            <div class="p-5 flex-1 flex flex-col">
              <h2 class="text-xl font-bold text-white mb-2 group-hover:text-raid-gold transition-colors line-clamp-2">
                {boss.name}
              </h2>
              
              {/* Etiquetas de Dificultad */}
              {boss.difficulty && boss.difficulty.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-auto pt-4">
                  {boss.difficulty.map((diff: string) => {
                    let colorClass = "bg-gray-700 text-gray-300";
                    if (diff.toLowerCase().includes("difícil") || diff.toLowerCase().includes("dificil")) colorClass = "bg-blue-900/50 text-blue-300 border border-blue-700";
                    else if (diff.toLowerCase().includes("brutal")) colorClass = "bg-purple-900/50 text-purple-300 border border-purple-700";
                    else if (diff.toLowerCase().includes("pesadilla") && !diff.toLowerCase().includes("súper")) colorClass = "bg-red-900/50 text-red-300 border border-red-700";
                    else if (diff.toLowerCase().includes("súper")) colorClass = "bg-red-950 text-red-400 border border-red-500 font-bold";
                    else colorClass = "bg-green-900/50 text-green-300 border border-green-700";
                    
                    return (
                      <span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-sm ${colorClass}`}>
                        {diff}
                      </span>
                    );
                  })}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-raid-card border border-gray-700 rounded-xl">
        <p class="text-gray-400">Aún no hay jefes registrados en esta categoría.</p>
        <a href="/admin" class="inline-block mt-4 text-raid-gold hover:underline">Ir al Panel de Administración</a>
      </div>
    )}
  </div>
</Layout>
