---
import SearchBar from "./ui/SearchBar";
import ActiveEvents from "./ui/ActiveEvents";
import PromoCodeBtn from "./ui/PromoCodeBtn";
import { Image } from "astro:assets";
import logo from "../assets/icons/favicon-no-bg.webp";

import { getChampionsSearchData } from "../utils/champions";

// Cargar la data de los campeones para el buscador en tiempo real
const searchData = getChampionsSearchData();

// Cargar eventos globales
const globalEventFiles = import.meta.glob(
  "/src/data/live-ops/global-events/*.json",
  { eager: true },
);
const globalEvents = Object.values(globalEventFiles).map(
  (file: any) => file.default || file,
);
---

<header class="bg-raid-bg border-b border-gray-700 sticky top-0 z-50">
  <!-- Top banner for events and promo code -->
  <div
    class="bg-raid-card border-b border-gray-800 py-1.5 px-4 sm:px-6 lg:px-8"
  >
    <div
      class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center text-sm gap-2 sm:gap-0"
    >
      <!-- Active Events Island -->
      <ActiveEvents client:idle events={globalEvents} />

      <!-- Promo Code Component (Island) -->
      <PromoCodeBtn client:idle />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo/Brand -->
      <div class="shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <div
            class="text-2xl font-black bg-linear-to-r from-raid-gold to-raid-purple bg-clip-text text-transparent"
          >
            <Image
              src={logo}
              alt="El Tomo Legendario"
              width={32}
              height={32}
              loading="eager"
              decoding="async"
              class="w-8 h-8 object-contain"
            />
          </div>
          <span
            class="text-lg font-bold text-white group-hover:text-raid-gold transition-colors"
          >
            El Tomo Legendario
          </span>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center justify-center flex-1 gap-8">
        <a
          href="/"
          class="text-gray-300 hover:text-raid-gold transition-colors text-sm font-semibold"
        >
          Home
        </a>
        <a
          href="/facciones"
          class="text-gray-300 hover:text-raid-purple transition-colors text-sm font-semibold"
        >
          Facciones
        </a>
        <a
          href="/guias-pve"
          class="text-gray-300 hover:text-raid-blue transition-colors text-sm font-semibold"
        >
          Guías
        </a>
        <!-- <a
          href="/comunidad"
          class="text-gray-300 hover:text-raid-gold transition-colors text-sm font-semibold"
        >
          Comunidad
        </a> -->
      </nav>

      <!-- Search & CTA Button -->
      <div class="flex items-center gap-4">
        <div class="hidden lg:block">
          <SearchBar client:idle champs={searchData} />
        </div>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-raid-card transition-colors text-raid-gold"
          aria-label="Toggle menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              id="menu-path"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu (Hidden by default) -->
    <div
      id="mobile-menu"
      class="hidden md:hidden bg-raid-card border-t border-gray-700 animate-fade-in absolute top-16 left-0 right-0 shadow-xl z-50"
    >
      <nav class="flex flex-col p-4 space-y-4">
        <a
          href="/"
          class="text-gray-300 hover:text-raid-gold transition-colors font-semibold block py-2 border-b border-gray-700/50"
        >
          Home
        </a>
        <a
          href="/facciones"
          class="text-gray-300 hover:text-raid-purple transition-colors font-semibold block py-2 border-b border-gray-700/50"
        >
          Facciones
        </a>
        <a
          href="/guias-pve"
          class="text-gray-300 hover:text-raid-blue transition-colors font-semibold block py-2 border-b border-gray-700/50"
        >
          Guías
        </a>
        <!-- <a
          href="/comunidad"
          class="text-gray-300 hover:text-raid-gold transition-colors font-semibold block py-2"
        >
          Comunidad
        </a> -->
        <div class="pt-2">
          <SearchBar client:idle champs={searchData} />
        </div>
      </nav>
    </div>
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      const menuPath = document.getElementById("menu-path");

      if (btn && menu && menuPath) {
        // Reset state upon new page navigation
        menu.classList.add("hidden");
        menuPath.setAttribute("d", "M4 6h16M4 12h16M4 18h16");

        const toggleMenu = () => {
          const isHidden = menu.classList.contains("hidden");
          if (isHidden) {
            menu.classList.remove("hidden");
            menuPath.setAttribute("d", "M6 18L18 6M6 6l12 12"); // X icon
          } else {
            menu.classList.add("hidden");
            menuPath.setAttribute("d", "M4 6h16M4 12h16M4 18h16"); // Hamburger icon
          }
        };

        btn.onclick = (e) => {
          e.stopPropagation();
          toggleMenu();
        };

        const handleClickOutside = (event: MouseEvent) => {
          if (
            !menu.classList.contains("hidden") &&
            !menu.contains(event.target as Node) &&
            !btn.contains(event.target as Node)
          ) {
            menu.classList.add("hidden");
            menuPath.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
          }
        };

        document.addEventListener("click", handleClickOutside);
      }
    });
  </script>
</header>
